# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/recoverx?schema=public"

# Payment Provider Configuration: "simulation" or "razorpay"
# - simulation: Default self-contained deterministic demo engine (no credentials required)
# - razorpay: Connects directly to Razorpay Test Mode APIs
RECOVERX_PROVIDER=simulation

# Razorpay Test Mode Credentials (Required only when RECOVERX_PROVIDER=razorpay)
# Obtain test API keys from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
